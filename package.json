{
  "name": "coursewatch",
  "version": "0.2.37",
  "desktopBuild": 37,
  "windowsRevision": 0,
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx apps/local-service/src/main.ts",
    "start": "tsx apps/local-service/src/main.ts",
    "build": "npm run build:web && npm run build:extension && npm run build:server",
    "build:web": "vite build --config vite.config.ts",
    "build:icon": "tsx scripts/build-icon.ts",
    "build:extension": "wxt build apps/extension",
    "build:mac": "npm run build:web && npm run build:server && tsx scripts/build-macos.ts",
    "build:mac:all": "npm run build:web && npm run build:server && tsx scripts/build-macos.ts --arch=arm64 && tsx scripts/build-macos.ts --arch=x64",
    "build:win": "npm run build:web && npm run build:server && tsx scripts/build-windows.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "browser:install": "playwright install --no-shell chromium",
    "background": "tsx scripts/background.ts start",
    "stop": "tsx scripts/background.ts stop",
    "autostart": "tsx scripts/autostart.ts",
    "experiment": "tsx scripts/experiment.ts",
    "start:built": "node dist/server/apps/local-service/src/main.js",
    "build:server": "node scripts/build-server.mjs",
    "check:study-protection": "node scripts/verify-study-protection.mjs",
    "pretest": "npm run check:study-protection"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "better-sqlite3": "^13.1.1",
    "cheerio": "^1.2.0",
    "fastify": "^5.12.8",
    "lucide-vue-next": "^1.0.0",
    "naive-ui": "^2.45.3",
    "node-notifier": "^12.1.0",
    "nodemailer": "^10.5.0",
    "playwright": "^1.65.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.45",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/node-notifier": "^8.0.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "@wxt-dev/module-vue": "^1.0.3",
    "prettier": "^3.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "wxt": "^0.21.5"
  },
  "license": "SEE LICENSE IN TERMS.md"
}
